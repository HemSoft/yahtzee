{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "bun test packages/game-engine/tests/scoring.test.ts packages/game-engine/tests/game.test.ts packages/game-engine/tests/storage.test.ts packages/game-engine/tests/dice.test.ts packages/game-engine/tests/backendScores.test.ts packages/game-engine/tests/backendSessions.test.ts"
  },
  "coverageAnalysis": "off",
  "concurrency": 4,
  "checkers": ["typescript"],
  "typescriptChecker": { "prioritizePerformanceOverAccuracy": false },
  "tsconfigFile": "tsconfig.mutation.json",
  "plugins": ["@stryker-mutator/typescript-checker"],
  "mutate": [
    "packages/game-engine/src/scoring.ts",
    "packages/game-engine/src/game.ts",
    "packages/game-engine/src/storage.ts",
    "convex/lib/recordScore.ts",
    "convex/highScores.ts"
  ],
  "mutator": { "excludedMutations": ["StringLiteral"] },
  "ignorePatterns": ["reports", "apps", "packages/ui", ".agents", ".github", "docs"],
  "reporters": ["clear-text", "json", "html"],
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "htmlReporter": { "fileName": "reports/mutation/mutation.html" },
  "thresholds": { "high": 98, "low": 95, "break": 95 },
  "timeoutMS": 5000,
  "dryRunTimeoutMinutes": 2
}
